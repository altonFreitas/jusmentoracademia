# ---------------------------------------------------------------------------
# JusMentor Academia — environment variables
# Copy this file to ".env.local" and fill in your own values.
# ---------------------------------------------------------------------------

# Public site URL (used for SEO, sitemap, and social share links).
# Set this to your real domain once you launch, e.g. https://jusmentoracademia.org
NEXT_PUBLIC_SITE_URL=https://jusmentoracademia.org

# Supabase — powers the admin dashboard and live content.
# Get both values from your Supabase project: Settings → API.
# The public website still works with built-in content if these are left blank.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Contact form (optional).
# Leave blank to have the form open the visitor's email app addressed to the
# institute. Add a Formspree form ID (from https://formspree.io) to receive
# messages silently in the background instead — set to your inbox first.
NEXT_PUBLIC_FORMSPREE_ID=
